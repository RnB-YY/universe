# Copy to .env ON THE BACKEND HOST ONLY. Never commit .env.
OPENAI_API_KEY=
# DeepSeek-only: fill this key and leave OPENAI_API_KEY empty.
DEEPSEEK_API_KEY=
# Leave empty to auto-select: OpenAI if its key exists, otherwise DeepSeek.
# Explicit values: openai or deepseek. No automatic paid fallback on failure.
TRANSCRIBE_PROVIDER=
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSLATE_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-flash
# Set a long random access code before using paid APIs.
ACCESS_CODE=
PORT=8787
HOST=127.0.0.1
# For a remotely hosted backend: HOST=0.0.0.0 and configure HTTPS with your host.
ALLOWED_ORIGINS=https://heixiong.vip,http://localhost:8787,http://127.0.0.1:8787
DAILY_AUDIO_MINUTES=180
